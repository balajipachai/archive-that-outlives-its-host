# Copy to .env and fill in local, non-secret values.
# .env is gitignored; never commit a real private key here.

# Bee node HTTP API. Swarm Desktop exposes this on loopback once the node is running.
BEE_API_URL=http://localhost:1633

# Human-readable feed topic for this archive. Safe to commit once chosen (see
# published/archive-publication.json) — it is not a secret, just an identifier.
ARCHIVE_TOPIC=spiti-folios-v1

# Where the publisher looks for the feed-owner signing key. Exactly one of
# ARCHIVE_FEED_PRIVATE_KEY or ARCHIVE_FEED_KEY_FILE must be set for any
# state-changing operation. Leave both unset to run in read-only/local-dev mode.
#
# ARCHIVE_FEED_PRIVATE_KEY=<64-hex-chars, no 0x prefix, read from your own local shell env>
# ARCHIVE_FEED_KEY_FILE=/absolute/path/outside/this/repo/to/an/ignored/key/file

# Local operator token for the loopback publisher server. Generate your own,
# e.g. `openssl rand -hex 32`, and paste it into the bootstrap form once per
# session. Never commit the real value.
# LOCAL_OPERATOR_TOKEN=<generate-your-own-random-token>

# Port the loopback publisher API listens on (bound to 127.0.0.1 only).
PUBLISHER_PORT=4310

# Storage-health warning threshold, in days of remaining batch duration.
# Below this, the UI shows "Storage payment needs attention".
BATCH_WARNING_THRESHOLD_DAYS=14

# Practical per-file / total-collection limits enforced before upload begins.
ARCHIVE_MAX_FILE_BYTES=52428800
ARCHIVE_MAX_TOTAL_BYTES=536870912
ARCHIVE_MAX_FILE_COUNT=5000
