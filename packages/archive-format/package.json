{
  "name": "@archive/format",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Release schema, validation, hashing and path utilities shared by the publisher and the recovery reader. No Swarm/bee-js dependency by design.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./hash": "./src/hash.ts",
    "./paths-node": "./src/paths-node.ts",
    "./release-builder": "./src/release-builder.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
